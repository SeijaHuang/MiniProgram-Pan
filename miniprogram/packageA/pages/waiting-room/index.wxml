<!--pages/waiting-room/index.wxml-->
<view class="waiting-room">
    <!-- 入口模式 -->
    <block wx:if="{{ viewMode === 'entry' }}">
        <!-- 标题区域 -->
        <view class="waiting-room__header">
            <styled-title
                text='连接"孽缘"'
                customClass="waiting-room__title"
            ></styled-title>
        </view>

        <!-- 按钮区域 -->
        <view class="waiting-room__buttons">
            <!-- 发起申冤按钮 -->
            <view
                class="waiting-room__button-wrapper"
                animation="{{ hostButtonAnimation }}"
            >
                <styled-button
                    text="发起申冤"
                    color="yellow"
                    icon="📣"
                    customClass="waiting-room__styled-btn"
                    bindtap="onHostButtonTap"
                ></styled-button>
            </view>

            <!-- 加入房间按钮 -->
            <view
                class="waiting-room__button-wrapper"
                animation="{{ joinButtonAnimation }}"
            >
                <styled-button
                    text="加入房间"
                    color="blue"
                    icon="🔗"
                    customClass="waiting-room__styled-btn"
                    bindtap="onJoinButtonTap"
                ></styled-button>
            </view>
        </view>
    </block>

    <!-- 房主等待模式 -->
    <block wx:elif="{{ viewMode === 'host_waiting' }}">
        <view class="waiting-room__header">
            <styled-title
                text='连接"孽缘"'
                customClass="waiting-room__title"
            ></styled-title>
        </view>

        <view class="waiting-room__waiting">
            <!-- 房间号展示 -->
            <view class="waiting-room__room-info">
                <text class="waiting-room__room-label">房间号</text>
                <view class="waiting-room__room-code">
                    <text
                        wx:for="{{ roomCode }}"
                        wx:key="index"
                        class="waiting-room__room-digit"
                    >{{ item }}</text>
                </view>
            </view>

            <!-- 双方昵称（满员后显示） -->
            <view
                wx:if="{{ roomParticipants.length >= 2 }}"
                class="waiting-room__participants"
            >
                <text class="waiting-room__participants-label">双方已就位</text>
                <view class="waiting-room__participants-list">
                    <view
                        wx:for="{{ roomParticipants }}"
                        wx:key="nickname"
                        class="waiting-room__participant"
                    >
                        <text class="waiting-room__participant-name {{ item.isMe ? 'waiting-room__participant-name--me' : '' }}">
                            {{ item.nickname }}{{ item.isMe ? '（你）' : '' }}
                        </text>
                    </view>
                </view>
            </view>

            <!-- 等待文案（满员前显示） -->
            <view
                wx:if="{{ roomParticipants.length < 2 }}"
                class="waiting-room__waiting-text"
            >
                <text>{{ currentWaitingText }}</text>
            </view>

            <!-- 转发和取消按钮 -->
            <view class="waiting-room__cancel-wrapper">
                <styled-button
                    text="转发给好友"
                    color="yellow"
                    icon="📨"
                    bindtap="handleForwardRoom"
                    openType="share"
                ></styled-button>
                <styled-button
                    text="取消审判"
                    color="grey"
                    showShine="{{ false }}"
                    bindtap="onCancelHost"
                ></styled-button>
            </view>
        </view>
    </block>

    <!-- 访客等待模式 -->
    <block wx:elif="{{ viewMode === 'guest_waiting' }}">
        <view class="waiting-room__header">
            <styled-title
                text='连接"孽缘"'
                customClass="waiting-room__title"
            ></styled-title>
        </view>

        <view class="waiting-room__waiting">
            <view class="waiting-room__guest-info">
                <text class="waiting-room__guest-success">已成功加入房间</text>
                <view class="waiting-room__room-code waiting-room__room-code--small">
                    <text
                        wx:for="{{ roomCode }}"
                        wx:key="index"
                        class="waiting-room__room-digit waiting-room__room-digit--small"
                    >{{ item }}</text>
                </view>

                <!-- 双方昵称（满员后显示） -->
                <view
                    wx:if="{{ roomParticipants.length >= 2 }}"
                    class="waiting-room__participants"
                >
                    <text class="waiting-room__participants-label">双方已就位</text>
                    <view class="waiting-room__participants-list">
                        <view
                            wx:for="{{ roomParticipants }}"
                            wx:key="nickname"
                            class="waiting-room__participant"
                        >
                            <text class="waiting-room__participant-name {{ item.isMe ? 'waiting-room__participant-name--me' : '' }}">
                                {{ item.nickname }}{{ item.isMe ? '（你）' : '' }}
                            </text>
                        </view>
                    </view>
                </view>

                <text
                    wx:if="{{ roomParticipants.length < 2 }}"
                    class="waiting-room__guest-waiting"
                >等待开庭...</text>
            </view>
        </view>
    </block>

    <!-- 加入房间弹窗 -->
    <view
        wx:if="{{ showJoinModal }}"
        class="waiting-room__modal-mask"
        catchtouchmove="preventTouchMove"
        bindtap="onCloseModal"
    >
        <view class="waiting-room__modal" catchtap="preventTouchMove">
            <!-- 关闭按钮 -->
            <view class="waiting-room__modal-close" bindtap="onCloseModal">
                <text>×</text>
            </view>

            <!-- 弹窗标题 -->
            <text class="waiting-room__modal-title">请输入房间号</text>

            <!-- 6位输入框展示 -->
            <view class="waiting-room__code-input-wrapper">
                <view class="waiting-room__code-boxes" bindtap="onCodeBoxesTap">
                    <view
                        wx:for="{{ roomCodeDisplay }}"
                        wx:key="index"
                        class="waiting-room__code-box {{ item ? 'waiting-room__code-box--filled' : '' }}"
                    >
                        <text>{{ item }}</text>
                    </view>
                </view>
                <!-- 隐藏的真实输入框 -->
                <input
                    class="waiting-room__code-input"
                    type="number"
                    maxlength="6"
                    value="{{ roomCodeInput }}"
                    bindinput="onRoomCodeInput"
                    focus="{{ inputFocus }}"
                />
            </view>

            <!-- 错误提示 -->
            <view wx:if="{{ errorMessage }}" class="waiting-room__error">
                <text>{{ errorMessage }}</text>
            </view>

            <!-- 确认按钮 -->
            <styled-button
                text="确认加入"
                color="blue"
                showShine="{{ isJoinButtonDisabled ? false : true }}"
                disabled="{{ isJoinButtonDisabled }}"
                bindtap="onConfirmJoin"
            ></styled-button>
        </view>
    </view>

    <!-- 倒计时组件 -->
    <countdown
        id="countdown"
        duration="{{ 3 }}"
        subtext="即将开庭"
        bindcomplete="onCountdownComplete"
    ></countdown>
</view>

<!-- 昵称设置弹窗 -->
<view
    wx:if="{{ showNicknameModal }}"
    class="nickname-modal"
    catchtouchmove="onNicknameModalMaskTap"
>
    <!-- 遮罩层 -->
    <view
        class="nickname-modal__overlay"
        bindtap="onNicknameModalMaskTap"
    ></view>

    <!-- 弹窗面板 -->
    <view
        class="nickname-modal__panel"
        animation="{{ nicknameModalAnimation }}"
        catchtap=""
    >
        <!-- 拖拽指示条 -->
        <view class="nickname-modal__drag-bar">
            <view class="nickname-modal__drag-line"></view>
        </view>

        <!-- 标题 -->
        <view class="nickname-modal__title">
            <text class="nickname-modal__title-text">堂下何人，报上名来！</text>
        </view>

        <!-- 昵称输入框 -->
        <view class="nickname-modal__input-wrapper">
            <input
                class="nickname-modal__input"
                type="nickname"
                placeholder="点击从微信昵称中选择"
                maxlength="12"
                value="{{ nicknameInput }}"
                bindinput="onNicknameInput"
            />
            <text class="nickname-modal__char-count">{{ nicknameCharCount }}/12</text>
        </view>

        <!-- 确认按钮 -->
        <view class="nickname-modal__actions">
            <styled-button
                text="击鼓申冤！"
                color="red"
                disabled="{{ isNicknameConfirmDisabled }}"
                showShine="{{ !isNicknameConfirmDisabled }}"
                bindtap="onNicknameConfirm"
            ></styled-button>
            <view
                class="nickname-modal__skip"
                bindtap="onNicknameSkip"
            >
                <text class="nickname-modal__skip-text">稍后再说</text>
            </view>
        </view>
    </view>
</view>
