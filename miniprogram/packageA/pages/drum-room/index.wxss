/* pages/drum-room/index.wxss */

/* ========================================
   Page Container
   ======================================== */
.page-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    min-height: 100vh;
    padding-top: 100rpx;
}

.drum-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 750rpx;
    box-sizing: border-box;
    padding: 40rpx 30rpx;
    padding-top: 60rpx;
    background: linear-gradient(135deg, #ff3b30 0%, #ff7a00 50%, #ffc400 100%);
    position: relative;
    overflow: hidden;
}

.section-container {
    display: flex;
    flex-direction: column;
    gap: 60rpx;
}

/* ========================================
   Header Section
   ======================================== */
.drum-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
}

.drum-header__title {
    font-size: 40rpx;
    font-weight: 800;
    color: #ffffff;
    text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
    letter-spacing: 4rpx;
}

.drum-header__timer {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 20rpx;
}

.drum-header__timer-label {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.85);
}

.drum-header__timer-value-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
}

.drum-header__timer-value {
    font-size: 56rpx;
    font-weight: 900;
    color: #ffe66d;
    text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 最后 3 秒紧急状态 */
.drum-header__timer--urgent {
    border-radius: 20rpx;
    padding: 10rpx 30rpx;
}

.drum-header__timer-value--urgent {
    font-size: 72rpx;
    color: #ff3b3b;
    text-shadow:
        0 0 20rpx rgba(255, 59, 59, 0.8),
        0 4rpx 8rpx rgba(0, 0, 0, 0.4);
}

/* ========================================
   Score Section
   ======================================== */
.drum-score {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    padding: 0 20rpx;
}

.drum-score__player {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 240rpx;
}

.drum-score__player--left {
    align-items: flex-start;
}

.drum-score__player--right {
    align-items: flex-end;
}

.drum-score__name {
    font-size: 26rpx;
    color: #ffffff;
    margin-bottom: 8rpx;
    max-width: 200rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.drum-score__value {
    font-size: 48rpx;
    font-weight: 900;
    color: #ffffff;
    text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
    margin-bottom: 12rpx;
}

.drum-score__progress {
    width: 200rpx;
    height: 20rpx;
    border-radius: 10rpx;
    background: rgba(0, 0, 0, 0.25);
    border: 4rpx solid #000000;
    overflow: hidden;
}

.drum-score__progress-bar {
    height: 100%;
    border-radius: 6rpx;
}

.drum-score__progress-bar--a {
    background: linear-gradient(90deg, #4d96ff, #6db3f2);
}

.drum-score__progress-bar--b {
    background: linear-gradient(90deg, #ff006e, #ff4d8d);
}

.drum-score__vs {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 30rpx;
}

.drum-score__vs-text {
    font-size: 36rpx;
    font-weight: 900;
    color: #ffe66d;
    text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.4);
}

/* ========================================
   Fly Text Layer
   ======================================== */
.drum-fly-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
}

.drum-fly-text {
    position: absolute;
    pointer-events: none;
}

.drum-fly-text__content {
    font-size: 36rpx;
    font-weight: 700;
    color: #ffe66d;
    text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.5);
}

/* ========================================
   Drum Button
   ======================================== */
.drum-button-container {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 40rpx;
    z-index: 5;
}

.drum-button {
    width: 280rpx;
    height: 280rpx;
    border-radius: 50%;
    background: radial-gradient(
        circle at 30% 30%,
        #ff5252,
        #ff3b3b 40%,
        #b80000 100%
    );
    border: 10rpx solid #ffd93d;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
        0 0 0 10rpx rgba(255, 217, 61, 0.3),
        0 20rpx 40rpx rgba(0, 0, 0, 0.4),
        inset 0 -10rpx 20rpx rgba(0, 0, 0, 0.3),
        inset 0 10rpx 20rpx rgba(255, 255, 255, 0.2);
}

.drum-button--active {
    opacity: 1;
}

.drum-button--disabled {
    opacity: 0.6;
}

.drum-button__text {
    font-size: 96rpx;
    font-weight: 900;
    color: #ffd93d;
    text-shadow:
        0 6rpx 0 #8b0000,
        0 8rpx 16rpx rgba(0, 0, 0, 0.4);
}

/* ========================================
   Hint Text
   ======================================== */
.drum-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 20rpx;
}

.drum-hint__text {
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
    text-align: center;
    letter-spacing: 2rpx;
}

/* ========================================
   Prepare Countdown Overlay
   ======================================== */
.drum-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 0;
    visibility: hidden;
}

.drum-overlay--visible {
    opacity: 1;
    visibility: visible;
}

.drum-overlay__content {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.drum-overlay__countdown {
    font-size: 160rpx;
    font-weight: 900;
    color: #ffffff;
    text-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.4);
}

.drum-overlay__hint {
    font-size: 32rpx;
    color: #ffe66d;
    letter-spacing: 4rpx;
    margin-top: 30rpx;
    text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
}
