<!--pages/drum-room/index.wxml-->
<view class="drum-page" animation="{{ containerAnimationData }}">
    <view class="page-container">
        <view class="section-container">
        <!-- Header Section -->
        <view class="drum-header">
            <text class="drum-header__title">震天鼓抢麦</text>
            <view class="drum-header__timer {{ isLastThreeSeconds ? 'drum-header__timer--urgent' : '' }}" wx:if="{{ phase === 'RUNNING' }}">
                <text class="drum-header__timer-label">剩余时间</text>
                <view class="drum-header__timer-value-wrapper" animation="{{ timerAnimationData }}">
                    <text class="drum-header__timer-value {{ isLastThreeSeconds ? 'drum-header__timer-value--urgent' : '' }}">{{ runningLeftSec }}秒</text>
                </view>
            </view>
        </view>

        <!-- Score Section -->
        <view class="drum-score">
            <!-- Player A -->
            <view class="drum-score__player drum-score__player--left">
                <text class="drum-score__name">{{ organizerName }}</text>
                <text class="drum-score__value">{{ organizerScore }}</text>
                <view class="drum-score__progress">
                    <view class="drum-score__progress-bar drum-score__progress-bar--a"
                          style="width: {{ progressA }}%;"></view>
                </view>
            </view>

            <!-- VS -->
            <view class="drum-score__vs">
                <text class="drum-score__vs-text">VS</text>
            </view>

            <!-- Player B -->
            <view class="drum-score__player drum-score__player--right">
                <text class="drum-score__name">{{ joinerName }}</text>
                <text class="drum-score__value">{{ joinerScore }}</text>
                <view class="drum-score__progress">
                    <view class="drum-score__progress-bar drum-score__progress-bar--b"
                          style="width: {{ progressB }}%;"></view>
                </view>
            </view>
        </view>

        </view>

        <!-- Fly Text Layer -->
        <view class="drum-fly-layer">
            <view
                wx:for="{{ flyTexts }}"
                wx:key="id"
                class="drum-fly-text"
                style="left: {{ item.x }}rpx; top: {{ item.y }}rpx; transform: rotate({{ item.rotate }}deg);"
            >
                <text class="drum-fly-text__content">{{ item.text }}</text>
            </view>
        </view>

        <!-- Drum Button -->
        <view class="drum-button-container">
            <view
                class="drum-button {{ tapEnabled ? 'drum-button--active' : 'drum-button--disabled' }}"
                animation="{{ drumAnimationData }}"
                bindtap="onDrumTap"
            >
                <text class="drum-button__text">冤</text>
            </view>
        </view>

        <!-- Prepare Countdown Component -->
        <countdown
            id="countdown"
            duration="{{ 3 }}"
            subtext="准备击鼓抢麦"
            bind:complete="onCountdownComplete"
        />

        <!-- Rule Notification (shown while waiting for both players to ready up) -->
        <notification
            isOpen="{{ showRuleNotification }}"
            title="规则"
            content="接下来10秒内，谁先击鼓达到{{ maxTaps }}次，谁先发言"
            statusText="{{ readyCount === 1 ? '等待对方准备' : '等待双方准备' }}"
            buttonText="开始游戏"
            disabledAfterClick="{{ true }}"
            bind:close="onRuleNotificationClose"
            bind:buttonTap="onStartGameTap"
        />

        <!-- Result Notification -->
        <notification
            isOpen="{{ resultVisible }}"
            title="{{ resultTitle }}"
            content="{{ resultSubtitle }}"
            statusText="{{ resultScoreText }}"
            bind:close="onResultNotificationClose"
        />
    </view>
</view>
