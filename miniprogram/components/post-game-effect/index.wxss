/* components/post-game-effect/index.wxss */

.pge__overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    pointer-events: none;
}

.pge__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
}

.pge__icon {
    font-size: 160rpx;
    line-height: 1;
}

.pge__text {
    font-size: 72rpx;
    font-weight: bold;
    margin-top: 24rpx;
    letter-spacing: 4rpx;
}

.pge__text--red {
    color: #ff2d55;
    text-shadow: 0 0 20rpx rgba(255, 45, 85, 0.8);
}

.pge__text--white {
    color: #ffffff;
    text-shadow: 0 0 20rpx rgba(0, 0, 0, 0.6);
}
