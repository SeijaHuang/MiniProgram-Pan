<!--components/post-game-effect/index.wxml-->
<view
    wx:if="{{ visible }}"
    class="pge__overlay"
>
    <view
        wx:if="{{ type === 'stamp_death' }}"
        class="pge__content"
        animation="{{ stampAnim }}"
    >
        <text class="pge__icon">⚔️</text>
        <text class="pge__text pge__text--red">承受制裁！</text>
    </view>
    <view
        wx:if="{{ type === 'beg_emoji' }}"
        class="pge__content"
        animation="{{ begAnim }}"
    >
        <text class="pge__icon">🧎</text>
        <text class="pge__text pge__text--white">求饶小命</text>
    </view>
</view>
