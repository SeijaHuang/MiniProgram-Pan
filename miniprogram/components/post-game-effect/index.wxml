<!--components/post-game-effect/index.wxml-->
<view
    class="post-game-effect"
    wx:if="{{ showEffect }}"
>
    <!-- stamp_death: Big red "卒" stamp -->
    <view
        wx:if="{{ effectType === 'stamp_death' }}"
        class="post-game-effect__stamp"
        animation="{{ stampAnimation }}"
    >
        <text class="post-game-effect__stamp-text">卒</text>
    </view>

    <!-- beg_emoji: Floating emoji + text -->
    <view
        wx:if="{{ effectType === 'beg_emoji' }}"
        class="post-game-effect__beg"
        animation="{{ begAnimation }}"
    >
        <text class="post-game-effect__beg-emoji">🥺</text>
        <text class="post-game-effect__beg-text">求求了~</text>
    </view>
</view>
