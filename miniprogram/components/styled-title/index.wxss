/* components/styled-title/index.wxss */

.styled-title {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 48rpx;
}

/* 主标题初始状态：缩小 + 旋转 + 透明 */
.styled-title--initial {
    opacity: 0;
    transform: scale(0) rotate(-180deg);
}

.styled-title__text {
    font-size: 96rpx;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 8rpx;
    text-shadow:
        /* 黑色描边（四周） */
        -3rpx 0 0 #000000,
        3rpx 0 0 #000000,
        0 -3rpx 0 #000000,
        0 3rpx 0 #000000,
        -3rpx -3rpx 0 #000000,
        3rpx -3rpx 0 #000000,
        -3rpx 3rpx 0 #000000,
        3rpx 3rpx 0 #000000,
        /* 右下角黑色投影 */ 8rpx 10rpx 0 #000000;
}
