/* components/countdown/index.wxss */

/* ========================================
   倒计时遮罩层
   ======================================== */
.countdown-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
}

/* ========================================
   倒计时内容区域
   ======================================== */
.countdown {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80rpx;
}

/* 数字容器 */
.countdown__number {
    display: flex;
    align-items: center;
    justify-content: center;
}

/* 数字样式 - 漫画风格 */
.countdown__number text {
    font-size: 180rpx;
    font-weight: 900;
    color: #ffd200;
    text-shadow:
        /* 描边效果 */
        -8rpx -8rpx 0 #000000,
        8rpx -8rpx 0 #000000,
        -8rpx 8rpx 0 #000000,
        8rpx 8rpx 0 #000000,
        0 -10rpx 0 #000000,
        0 10rpx 0 #000000,
        -10rpx 0 0 #000000,
        10rpx 0 0 #000000,
        /* 立体投影效果 */
        12rpx 12rpx 0 rgba(0, 0, 0, 0.6);
    line-height: 1;
}

/* 文字样式 */
.countdown__text {
    font-size: 48rpx;
    color: #ffffff;
    font-weight: 700;
    margin-top: 40rpx;
    text-shadow:
        -2rpx -2rpx 0 #000000,
        2rpx -2rpx 0 #000000,
        -2rpx 2rpx 0 #000000,
        2rpx 2rpx 0 #000000;
}
