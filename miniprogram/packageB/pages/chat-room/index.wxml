<!--
    Chat Room Page - 对簿公堂 / 语音申冤页
    Phase: SPEAKER_A -> SPEAKER_B -> DONE
-->
<view class="chat-room">
    <!-- 顶部区域：倒计时 -->
    <view class="chat-room__top-section">
        <!-- 倒计时区域：发言者显示倒计时，非发言者显示提示文案 -->
        <view class="chat-room__countdown-area">
            <view wx:if="{{canSpeak}}" class="chat-room__countdown chat-room__countdown--{{countdownClass}}">
                <text class="chat-room__countdown-text">{{remaining}}</text>
            </view>
            <view wx:else class="chat-room__listener-hint">
                <text class="chat-room__listener-hint-text">{{listenerHint}}</text>
            </view>
        </view>
    </view>

    <!-- 飞行表情层：自己发送的表情 -->
    <view class="chat-room__reactions">
        <view
            wx:for="{{myReactions}}"
            wx:key="id"
            class="chat-room__reaction chat-room__reaction--lane{{item.lane}}"
            animation="{{item.animationData}}"
        >
            <text class="chat-room__reaction-emoji">{{item.emoji}}</text>
        </view>
    </view>

    <!-- 飞行表情层：对方发送的表情 -->
    <view class="chat-room__reactions">
        <view
            wx:for="{{opponentReactions}}"
            wx:key="id"
            class="chat-room__reaction chat-room__reaction--lane{{item.lane}}"
            animation="{{item.animationData}}"
        >
            <text class="chat-room__reaction-emoji">{{item.emoji}}</text>
        </view>
    </view>

    <!-- 对话框区域 - 按阶段持久化显示的语音转文字内容 -->
    <scroll-view
        class="chat-room__dialog"
        scroll-y="{{true}}"
        scroll-into-view="{{(speakerBFinal || speakerBLive) ? 'msg-speaker-b' : (speakerAFinal || speakerALive) ? 'msg-speaker-a' : ''}}"
        scroll-with-animation="{{true}}"
    >
        <view class="chat-room__dialog-inner">
            <!-- Phase A 区（原告 / Organizer / Host） -->
            <view
                wx:if="{{speakerAFinal || speakerALive}}"
                id="msg-speaker-a"
                class="chat-room__section"
            >
                <view class="chat-room__section-title">
                    <text>{{speakerAName}}的诉状</text>
                </view>
                <view class="chat-room__section-text">
                    <text>{{speakerAFinal}}{{speakerALive}}</text>
                </view>
            </view>

            <!-- 分割线（两段都有内容时显示） -->
            <view
                wx:if="{{(speakerAFinal || speakerALive) && (speakerBFinal || speakerBLive)}}"
                class="chat-room__divider"
            >
                <text class="chat-room__divider-text">------------------我是分割线------------------</text>
            </view>

            <!-- Phase B 区（被告 / Joiner / Guest） -->
            <view
                wx:if="{{speakerBFinal || speakerBLive}}"
                id="msg-speaker-b"
                class="chat-room__section"
            >
                <view class="chat-room__section-title">
                    <text>{{speakerBName}}的诉状</text>
                </view>
                <view class="chat-room__section-text">
                    <text>{{speakerBFinal}}{{speakerBLive}}</text>
                </view>
            </view>
        </view>
    </scroll-view>

    <!-- 麦克风按钮（仅发言者显示） -->
    <view wx:if="{{canSpeak}}" class="chat-room__mic-area">
        <view class="chat-room__mic-buttons">
            <view
                class="chat-room__mic {{isRecording ? 'chat-room__mic--recording' : 'chat-room__mic--active'}}"
                bindtouchstart="onMicTouchStart"
                bindtouchend="onMicTouchEnd"
                bindtouchcancel="onMicTouchCancel"
            >
                <text class="chat-room__mic-icon">🎤</text>
            </view>
            <view 
                class="chat-room__end-btn"
                bindtap="onEndEarlyTap"
            >
                <text class="chat-room__end-btn-icon">✕</text>
            </view>
        </view>
        <text class="chat-room__mic-label">
            {{isRecording ? '松开结束' : '按住说话'}}
        </text>
    </view>

    <!-- 底部表情面板（仅非发言者显示） -->
    <view wx:if="{{!canSpeak}}" class="chat-room__emoji-panel">
        <text class="chat-room__emoji-hint">用表情包宣泄你的不满吧，大老爷看不到的哦~</text>
        <view class="chat-room__emoji-grid">
            <view
                wx:for="{{emojiList}}"
                wx:key="*this"
                class="chat-room__emoji-btn"
                data-emoji="{{item}}"
                data-index="{{index}}"
                bindtap="onEmojiTap"
                animation="{{emojiAnimations[index]}}"
            >
                <text class="chat-room__emoji-text">{{item}}</text>
            </view>
        </view>
    </view>

    <!-- 提前结束确认弹窗 -->
    <notification
        isOpen="{{showEndEarlyNotification}}"
        title="警告"
        content="这就没话说了？看来也没什么苦吗！"
        buttonText="我说完了"
        bind:close="onEndEarlyCancel"
        bind:buttonTap="onEndEarlyConfirm"
    />

    <!-- 告状须知弹窗 -->
    <notification
        isOpen="{{showNotification}}"
        title="告状须知"
        content="长按点击麦克风，抓紧属于你的60秒吐槽机会，向青天大老爷好好诉诉苦吧（注意不要松手哦）"
        buttonText="我明白了"
        bind:close="onNotificationDismiss"
        bind:buttonTap="onNotificationDismiss"
    />

    <!-- 切换提示遮罩 -->
    <view
        wx:if="{{showSwitchNotification}}"
        class="chat-room__switch-mask"
        catchtouchmove="preventTouchMove"
    >
        <view class="chat-room__switch-content">
            <text class="chat-room__switch-text">{{switchNotificationText}}</text>
        </view>
    </view>

    <!-- 安全区域 -->
    <view class="chat-room__safe-area"></view>
</view>
