<!--
    Chat Room Page - 对簿公堂 / 语音申冤页
    Phase: SPEAKER_A -> SPEAKER_B -> DONE
-->
<view class="chat-room">
    <!-- 顶部区域：倒计时 + 发言舞台 -->
    <view class="chat-room__top-section">
        <!-- 倒计时区域：发言者显示倒计时，非发言者显示提示文案 -->
        <view class="chat-room__countdown-area">
            <view wx:if="{{canSpeak}}" class="chat-room__countdown chat-room__countdown--{{countdownClass}}">
                <text class="chat-room__countdown-text">{{remaining}}</text>
            </view>
            <view wx:else class="chat-room__listener-hint">
                <text class="chat-room__listener-hint-text">{{listenerHint}}</text>
            </view>
        </view>

        <!-- 发言舞台区 -->
        <view class="chat-room__stage">
            <!-- 提示文案 -->
            <view class="chat-room__stage-hint" wx:if="{{canSpeak && !isRecording}}">
                <text>按住麦克风开始申冤</text>
            </view>
            <view class="chat-room__stage-hint" wx:elif="{{!canSpeak}}">
                <text>等待对方陈述...</text>
            </view>

            <!-- 录音中显示波纹动画 -->
            <view class="chat-room__recording-wave" wx:if="{{isRecording}}">
                <view class="chat-room__wave-bar"></view>
                <view class="chat-room__wave-bar"></view>
                <view class="chat-room__wave-bar"></view>
                <view class="chat-room__wave-bar"></view>
                <view class="chat-room__wave-bar"></view>
            </view>
        </view>
    </view>

    <!-- 飞行表情层：自己发送的表情 -->
    <view class="chat-room__reactions">
        <view
            wx:for="{{myReactions}}"
            wx:key="id"
            class="chat-room__reaction chat-room__reaction--lane{{item.lane}}"
            animation="{{item.animationData}}"
        >
            <text class="chat-room__reaction-emoji">{{item.emoji}}</text>
        </view>
    </view>

    <!-- 飞行表情层：对方发送的表情 -->
    <view class="chat-room__reactions">
        <view
            wx:for="{{opponentReactions}}"
            wx:key="id"
            class="chat-room__reaction chat-room__reaction--lane{{item.lane}}"
            animation="{{item.animationData}}"
        >
            <text class="chat-room__reaction-emoji">{{item.emoji}}</text>
        </view>
    </view>

    <!-- 对话框区域 - 按阶段持久化显示的语音转文字内容 -->
    <scroll-view
        class="chat-room__dialog"
        scroll-y="{{true}}"
        scroll-into-view="{{speakerBFinal || speakerBLive ? 'msg-speaker-b' : ''}}"
        scroll-with-animation="{{true}}"
    >
        <view class="chat-room__dialog-inner">
            <!-- Phase A 气泡（原告 / Organizer） -->
            <view
                wx:if="{{speakerAFinal || speakerALive}}"
                id="msg-speaker-a"
                class="chat-room__message chat-room__message--{{localRole === 'Organizer' ? 'self' : 'other'}}"
            >
                <view class="chat-room__message-bubble">
                    <text class="chat-room__message-text">{{speakerAFinal}}{{speakerALive}}</text>
                </view>
                <view class="chat-room__message-role">
                    <text>原告</text>
                </view>
            </view>

            <!-- Phase B 气泡（被告 / Joiner） -->
            <view
                wx:if="{{speakerBFinal || speakerBLive}}"
                id="msg-speaker-b"
                class="chat-room__message chat-room__message--{{localRole === 'Joiner' ? 'self' : 'other'}}"
            >
                <view class="chat-room__message-bubble">
                    <text class="chat-room__message-text">{{speakerBFinal}}{{speakerBLive}}</text>
                </view>
                <view class="chat-room__message-role">
                    <text>被告</text>
                </view>
            </view>
        </view>
    </scroll-view>

    <!-- 麦克风按钮 -->
    <view class="chat-room__mic-area">
        <view
            class="chat-room__mic {{canSpeak ? (isRecording ? 'chat-room__mic--recording' : 'chat-room__mic--active') : 'chat-room__mic--disabled'}}"
            bindtouchstart="onMicTouchStart"
            bindtouchend="onMicTouchEnd"
            bindtouchcancel="onMicTouchCancel"
        >
            <text class="chat-room__mic-icon">🎤</text>
        </view>
        <text class="chat-room__mic-label">
            {{isRecording ? '松开结束' : (canSpeak ? '按住说话' : '等待发言')}}
        </text>
    </view>

    <!-- 底部表情面板 -->
    <view class="chat-room__emoji-panel {{canReact ? '' : 'chat-room__emoji-panel--disabled'}}">
        <view
            wx:for="{{emojiList}}"
            wx:key="*this"
            class="chat-room__emoji-btn"
            data-emoji="{{item}}"
            data-index="{{index}}"
            bindtap="onEmojiTap"
            animation="{{emojiAnimations[index]}}"
        >
            <text class="chat-room__emoji-text">{{item}}</text>
        </view>
    </view>

    <!-- 安全区域 -->
    <view class="chat-room__safe-area"></view>
</view>
