/**
 * Chat Room Page Styles
 * 对簿公堂 / 语音申冤页样式
 */

/* ==================== Page Container ==================== */

.chat-room {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f0f23 100%);
    position: relative;
    overflow: hidden;
}

/* ==================== Top Section (Countdown + Stage) ==================== */

.chat-room__top-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: env(safe-area-inset-top);
}

/* ==================== Countdown Area ==================== */

.chat-room__countdown-area {
    padding-top: 40rpx;
    padding-bottom: 20rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.chat-room__countdown {
    width: 150rpx;
    height: 150rpx;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 6rpx solid currentColor;
    background: rgba(255, 255, 255, 0.05);
}

.chat-room__countdown-text {
    font-size: 80rpx;
    font-weight: bold;
    font-family: 'Helvetica Neue', sans-serif;
}

/* Normal: >30s - White */
.chat-room__countdown--normal {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.6);
}

/* Warn: 30-10s - Yellow + Breathing */
.chat-room__countdown--warn {
    color: #ffc107;
    border-color: #ffc107;
    animation: countdown-breathe 1s ease-in-out infinite;
}

/* Danger: <=10s - Red + Bounce */
.chat-room__countdown--danger {
    color: #ff4444;
    border-color: #ff4444;
    animation: countdown-bounce 0.5s ease-in-out infinite;
}

@keyframes countdown-breathe {
    0%,
    100% {
        transform: scale(1);
        opacity: 1;
    }
    50% {
        transform: scale(1.05);
        opacity: 0.8;
    }
}

@keyframes countdown-bounce {
    0%,
    100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.1);
    }
}

/* Listener Hint - 非发言者提示文案 */
.chat-room__listener-hint {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 150rpx;
    padding: 0 32rpx;
}

.chat-room__listener-hint-text {
    font-size: 30rpx;
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
    letter-spacing: 2rpx;
}

/* ==================== Reactions (Flying Emojis) ==================== */

.chat-room__reactions {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 100;
    overflow: hidden;
}

.chat-room__reaction {
    position: absolute;
    bottom: 400rpx;
}

.chat-room__reaction--lane0 {
    left: 100rpx;
}

.chat-room__reaction--lane1 {
    left: 50%;
}

.chat-room__reaction--lane2 {
    right: 100rpx;
}

.chat-room__reaction-emoji {
    font-size: 80rpx;
}

/* Mic Wave Animation (inside mic button when recording) */
.chat-room__mic-wave {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6rpx;
}

.chat-room__mic-wave-bar {
    width: 8rpx;
    height: 20rpx;
    background: #ffffff;
    border-radius: 4rpx;
    animation: wave-pulse 0.8s ease-in-out infinite;
}

.chat-room__mic-wave-bar:nth-child(1) {
    animation-delay: 0s;
}

.chat-room__mic-wave-bar:nth-child(2) {
    animation-delay: 0.1s;
}

.chat-room__mic-wave-bar:nth-child(3) {
    animation-delay: 0.2s;
}

.chat-room__mic-wave-bar:nth-child(4) {
    animation-delay: 0.3s;
}

.chat-room__mic-wave-bar:nth-child(5) {
    animation-delay: 0.4s;
}

@keyframes wave-pulse {
    0%,
    100% {
        height: 20rpx;
    }
    50% {
        height: 56rpx;
    }
}

/* ==================== Dialog Area ==================== */

.chat-room__dialog {
    flex: 1;
    min-height: 0;
    width: 100%;
    padding: 0 32rpx;
    box-sizing: border-box;
    overflow-y: scroll;
}

.chat-room__dialog::-webkit-scrollbar {
    width: 6rpx;
}

.chat-room__dialog::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 3rpx;
}

.chat-room__dialog::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 3rpx;
}

.chat-room__dialog-inner {
    display: flex;
    flex-direction: column;
    gap: 24rpx;
    padding: 24rpx 0;
}

/* Section (per-speaker block) */
.chat-room__section {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

/* Section Title - Centered speaker label */
.chat-room__section-title {
    text-align: center;
    font-size: 28rpx;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 2rpx;
}

/* Section Text - Transcribed speech */
.chat-room__section-text {
    font-size: 32rpx;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    word-wrap: break-word;
    padding: 24rpx 32rpx;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 16rpx;
}

/* Live (in-progress) text - visually distinct from finalized text */
.chat-room__section-text--live {
    color: rgba(255, 255, 255, 0.45);
    font-style: italic;
}

/* Divider between two speakers */
.chat-room__divider {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 8rpx 0;
}

.chat-room__divider-text {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 2rpx;
}

/* ==================== Microphone Area ==================== */

.chat-room__mic-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 40rpx;
    gap: 32rpx;
}

.chat-room__mic-buttons {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 100rpx;
}

.chat-room__mic {
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    transition:
        transform 0.15s ease-out,
        background 0.15s ease-out;
}

.chat-room__mic-icon {
    font-size: 64rpx;
}

/* Active: Green - Can Speak */
.chat-room__mic--active {
    background: linear-gradient(180deg, #4ade80 0%, #22c55e 100%);
    box-shadow: 0 8rpx 30rpx rgba(74, 222, 128, 0.4);
}

.chat-room__mic--active:active {
    transform: scale(0.95);
}

/* Connecting: Amber - Pressed but ASR not yet started */
.chat-room__mic--connecting {
    background: linear-gradient(180deg, #fbbf24 0%, #f59e0b 100%);
    box-shadow: 0 8rpx 30rpx rgba(251, 191, 36, 0.45);
    transform: scale(1.05);
}

/* Recording: Dark Green + Enlarged */
.chat-room__mic--recording {
    background: linear-gradient(180deg, #16a34a 0%, #15803d 100%);
    box-shadow: 0 8rpx 40rpx rgba(22, 163, 74, 0.6);
    transform: scale(1.15);
}

/* Disabled: Gray */
.chat-room__mic--disabled {
    background: linear-gradient(180deg, #6b7280 0%, #4b5563 100%);
    opacity: 0.6;
}

.chat-room__mic-label {
    margin-top: 20rpx;
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.6);
}

.chat-room__end-btn {
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(180deg, #ef4444 0%, #dc2626 100%);
    box-shadow: 0 8rpx 30rpx rgba(239, 68, 68, 0.4);
}

.chat-room__end-btn:active {
    transform: scale(0.95);
}

.chat-room__end-btn-icon {
    font-size: 56rpx;
    color: #ffffff;
    font-weight: bold;
}

/* ==================== Emoji Panel ==================== */

.chat-room__emoji-panel {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
    padding: 24rpx 32rpx;
    background: rgba(0, 0, 0, 0.3);
    border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.chat-room__emoji-hint {
    text-align: center;
    font-size: 24rpx;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 2rpx;
}

.chat-room__emoji-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16rpx;
}

.chat-room__emoji-btn {
    height: 88rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 16rpx;
}

.chat-room__emoji-btn:active {
    background: rgba(255, 255, 255, 0.2);
}

.chat-room__emoji-text {
    font-size: 40rpx;
}

/* ==================== Switch Notification ==================== */

.chat-room__switch-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
}

.chat-room__switch-content {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.chat-room__switch-text {
    font-size: 120rpx;
    font-weight: 900;
    color: #ffd200;
    text-shadow:
        /* 描边效果 */
        -8rpx -8rpx 0 #000000,
        8rpx -8rpx 0 #000000,
        -8rpx 8rpx 0 #000000,
        8rpx 8rpx 0 #000000,
        0 -10rpx 0 #000000,
        0 10rpx 0 #000000,
        -10rpx 0 0 #000000,
        10rpx 0 0 #000000,
        /* 立体投影效果 */ 12rpx 12rpx 0 rgba(0, 0, 0, 0.6);
    line-height: 1;
}

/* ==================== Safe Area ==================== */

.chat-room__safe-area {
    height: env(safe-area-inset-bottom);
}
