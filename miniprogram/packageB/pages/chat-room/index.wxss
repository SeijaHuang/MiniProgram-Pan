/**
 * Chat Room Page Styles
 * 对簿公堂 / 语音申冤页样式
 */

/* ==================== Page Container ==================== */

.chat-room {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f0f23 100%);
    position: relative;
    overflow: hidden;
}

/* ==================== Completed Transition ==================== */

.chat-room__completed {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 1;
    padding: 0 60rpx;
}

.chat-room__completed-text {
    font-size: 36rpx;
    color: rgba(255, 255, 255, 0.9);
    text-align: center;
    line-height: 1.8;
}

/* ==================== Top Section (Countdown + Stage) ==================== */

.chat-room__top-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: env(safe-area-inset-top);
}

/* ==================== Countdown Area ==================== */

.chat-room__countdown-area {
    padding-top: 40rpx;
    padding-bottom: 20rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.chat-room__countdown {
    width: 150rpx;
    height: 150rpx;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 6rpx solid currentColor;
    background: rgba(255, 255, 255, 0.05);
}

.chat-room__countdown-text {
    font-size: 80rpx;
    font-weight: bold;
    font-family: 'Helvetica Neue', sans-serif;
}

/* Normal: >30s - White */
.chat-room__countdown--normal {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.6);
}

/* Warn: 30-10s - Yellow + Breathing */
.chat-room__countdown--warn {
    color: #ffc107;
    border-color: #ffc107;
    animation: countdown-breathe 1s ease-in-out infinite;
}

/* Danger: <=10s - Red + Bounce */
.chat-room__countdown--danger {
    color: #ff4444;
    border-color: #ff4444;
    animation: countdown-bounce 0.5s ease-in-out infinite;
}

@keyframes countdown-breathe {
    0%,
    100% {
        transform: scale(1);
        opacity: 1;
    }
    50% {
        transform: scale(1.05);
        opacity: 0.8;
    }
}

@keyframes countdown-bounce {
    0%,
    100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.1);
    }
}

/* ==================== Reactions (Flying Emojis) ==================== */

.chat-room__reactions {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 100;
    overflow: hidden;
}

.chat-room__reaction {
    position: absolute;
    bottom: 400rpx;
}

.chat-room__reaction--lane0 {
    left: 100rpx;
}

.chat-room__reaction--lane1 {
    left: 50%;
}

.chat-room__reaction--lane2 {
    right: 100rpx;
}

.chat-room__reaction-emoji {
    font-size: 80rpx;
}

/* ==================== Stage Area ==================== */

.chat-room__stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20rpx 40rpx;
    min-height: 100rpx;
}

.chat-room__stage-hint {
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
    padding: 32rpx 48rpx;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 16rpx;
}

/* Speech Text - 实时语音识别文字 */
.chat-room__speech-text {
    max-width: 600rpx;
    padding: 24rpx 32rpx;
    background: rgba(74, 222, 128, 0.15);
    border: 2rpx solid rgba(74, 222, 128, 0.3);
    border-radius: 16rpx;
    margin-bottom: 20rpx;
}

.chat-room__speech-text--opponent {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
}

.chat-room__speech-text-content {
    font-size: 32rpx;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    word-wrap: break-word;
}

.chat-room__speech-text-placeholder {
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.5);
    font-style: italic;
}

/* Recording Wave Animation */
.chat-room__recording-wave {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    height: 120rpx;
}

.chat-room__wave-bar {
    width: 12rpx;
    height: 40rpx;
    background: #4ade80;
    border-radius: 6rpx;
    animation: wave-pulse 0.8s ease-in-out infinite;
}

.chat-room__wave-bar:nth-child(1) {
    animation-delay: 0s;
}

.chat-room__wave-bar:nth-child(2) {
    animation-delay: 0.1s;
}

.chat-room__wave-bar:nth-child(3) {
    animation-delay: 0.2s;
}

.chat-room__wave-bar:nth-child(4) {
    animation-delay: 0.3s;
}

.chat-room__wave-bar:nth-child(5) {
    animation-delay: 0.4s;
}

@keyframes wave-pulse {
    0%,
    100% {
        height: 40rpx;
    }
    50% {
        height: 100rpx;
    }
}

/* ==================== Dialog Area ==================== */

.chat-room__dialog {
    flex: 1;
    width: 100%;
    padding: 0 32rpx;
    box-sizing: border-box;
}

.chat-room__dialog-inner {
    display: flex;
    flex-direction: column;
    gap: 24rpx;
    padding: 24rpx 0;
}

/* Empty State */
.chat-room__dialog-empty {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 60rpx 0;
}

.chat-room__dialog-empty-text {
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.4);
}

/* Message Item */
.chat-room__message {
    display: flex;
    flex-direction: column;
    max-width: 80%;
}

/* Self Message - Right Aligned */
.chat-room__message--self {
    align-self: flex-end;
    align-items: flex-end;
}

/* Other Message - Left Aligned */
.chat-room__message--other {
    align-self: flex-start;
    align-items: flex-start;
}

/* Message Bubble */
.chat-room__message-bubble {
    padding: 24rpx 32rpx;
    border-radius: 24rpx;
    max-width: 100%;
    word-wrap: break-word;
}

.chat-room__message--self .chat-room__message-bubble {
    background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);
    border-bottom-right-radius: 8rpx;
}

.chat-room__message--other .chat-room__message-bubble {
    background: rgba(255, 255, 255, 0.15);
    border-bottom-left-radius: 8rpx;
}

.chat-room__message-text {
    font-size: 32rpx;
    line-height: 1.5;
}

.chat-room__message--self .chat-room__message-text {
    color: #0f0f23;
}

.chat-room__message--other .chat-room__message-text {
    color: rgba(255, 255, 255, 0.9);
}

/* Message Role Label */
.chat-room__message-role {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.5);
}

/* ==================== Microphone Area ==================== */

.chat-room__mic-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 40rpx;
}

.chat-room__mic {
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform 0.15s ease-out, background 0.15s ease-out;
}

.chat-room__mic-icon {
    font-size: 64rpx;
}

/* Active: Green - Can Speak */
.chat-room__mic--active {
    background: linear-gradient(180deg, #4ade80 0%, #22c55e 100%);
    box-shadow: 0 8rpx 30rpx rgba(74, 222, 128, 0.4);
}

.chat-room__mic--active:active {
    transform: scale(0.95);
}

/* Recording: Dark Green + Enlarged */
.chat-room__mic--recording {
    background: linear-gradient(180deg, #16a34a 0%, #15803d 100%);
    box-shadow: 0 8rpx 40rpx rgba(22, 163, 74, 0.6);
    transform: scale(1.15);
}

/* Disabled: Gray */
.chat-room__mic--disabled {
    background: linear-gradient(180deg, #6b7280 0%, #4b5563 100%);
    opacity: 0.6;
}

.chat-room__mic-label {
    margin-top: 20rpx;
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.6);
}

/* ==================== Emoji Panel ==================== */

.chat-room__emoji-panel {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20rpx;
    padding: 24rpx 32rpx;
    background: rgba(0, 0, 0, 0.3);
    border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.chat-room__emoji-panel--disabled {
    opacity: 0.4;
    pointer-events: none;
}

.chat-room__emoji-btn {
    width: 80rpx;
    height: 80rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 16rpx;
}

.chat-room__emoji-btn:active {
    background: rgba(255, 255, 255, 0.2);
}

.chat-room__emoji-text {
    font-size: 40rpx;
}

/* ==================== Safe Area ==================== */

.chat-room__safe-area {
    height: env(safe-area-inset-bottom);
}
