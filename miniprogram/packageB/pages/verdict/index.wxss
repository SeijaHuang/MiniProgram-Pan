/* packageB/pages/verdict/index.wxss */

/* ========================================
   Verdict Page
   ======================================== */

.verdict-page {
    background-color: #d4380d;
    padding-bottom: 30rpx;
    border-left: 8rpx solid #d4380d;
    border-right: 8rpx solid #d4380d;
    box-sizing: border-box;
}

/* Loading */
.verdict-page__loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.verdict-page__loading-text {
    font-size: 32rpx;
    color: #999999;
}

/* Off-screen canvas for image generation */
.verdict-page__offscreen-canvas {
    position: fixed;
    left: -9999rpx;
    top: -9999rpx;
    width: 750rpx;
    height: 1334rpx;
}

/* ========================================
   Header
   ======================================== */

.verdict-header {
    background-color: #d4380d;
    padding: 24rpx 32rpx 40rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16rpx;
    opacity: 0;
}

.verdict-header__icon-emoji {
    font-size: 80rpx;
    line-height: 1;
}

.verdict-header__title {
    font-size: 48rpx;
    font-weight: bold;
    color: #ffd93d;
}

.verdict-header__case-no {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.8);
}

/* ========================================
   Section Common
   ======================================== */

.verdict-section-wrapper {
    padding: 32rpx;
    border-radius: 32rpx;
    border: 2rpx solid #fffef7;
    display: flex;
    flex-direction: column;
    gap: 32rpx;
    background-color: #fffef7;
}

.verdict-section {
    padding: 32rpx;
    background-color: #ffffff;
    border-radius: 16rpx;
    border: 2rpx solid #e8e8e8;
    opacity: 0;
}

.verdict-section--center {
    display: flex;
    justify-content: center;
    background-color: transparent;
    border: none;
    padding: 0 32rpx;
}

.verdict-actions {
    flex-direction: column;
    gap: 24rpx;
    align-items: center;
}

.verdict-actions__btn {
    flex: 1;
    width: 70%;
}

.verdict-section__title {
    font-size: 36rpx;
    font-weight: bold;
    color: #d4380d;
    text-align: center;
    display: block;
    margin-bottom: 24rpx;
}

/* ========================================
   Responsibility
   ======================================== */

.responsibility {
    display: flex;
    flex-direction: row;
    gap: 16rpx;
}

.responsibility__card {
    flex: 1;
    border-radius: 12rpx;
    padding: 20rpx 16rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8rpx;
}

.responsibility__card--host {
    background-color: #dce9f5;
}

.responsibility__card--guest {
    background-color: #f5dce9;
}

.responsibility__card--third {
    background-color: #fffde0;
}

.responsibility__label {
    font-size: 22rpx;
    color: #666666;
}

.responsibility__percent {
    font-size: 64rpx;
    font-weight: bold;
    color: #d4380d;
}

.responsibility__factor {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4rpx;
    margin-top: 4rpx;
}

.responsibility__factor-emoji {
    font-size: 24rpx;
}

.responsibility__factor-name {
    font-size: 20rpx;
    color: #666666;
}

.responsibility__factor-pct {
    font-size: 20rpx;
    color: #d4380d;
    font-weight: bold;
}

/* ========================================
   Quote
   ======================================== */

.verdict-quote {
    background-color: #fffde0;
    border-radius: 12rpx;
    padding: 24rpx;
    position: relative;
    display: flex;
    flex-direction: row;
}

.verdict-quote__border {
    width: 8rpx;
    background-color: #ffd93d;
    border-radius: 4rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.verdict-quote__text {
    font-size: 30rpx;
    color: #333333;
    line-height: 1.8;
}

/* ========================================
   Punishment
   ======================================== */

.punishment-card {
    background-color: #fff0f0;
    border-radius: 12rpx;
    padding: 24rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12rpx;
}

.punishment-card__task {
    font-size: 32rpx;
    font-weight: bold;
    color: #d4380d;
    text-align: center;
}

.punishment-card__deadline {
    font-size: 24rpx;
    color: #999999;
}

/* ========================================
   Post-Game
   ======================================== */

.post-game {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24rpx;
}

.post-game__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8rpx;
    width: 100%;
}

.post-game__remaining {
    font-size: 28rpx;
    color: #999999;
}

.post-game__leave {
    margin-top: 16rpx;
    width: 70%;
}
