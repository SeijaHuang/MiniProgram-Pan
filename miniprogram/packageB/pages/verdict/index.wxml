<!--packageB/pages/verdict/index.wxml-->
<scroll-view
    scroll-y
    class="verdict-page"
>
    <!-- Loading -->
    <view wx:if="{{ loading }}" class="verdict-page__loading">
        <text class="verdict-page__loading-text">
            加载判决书中...
        </text>
    </view>

    <block wx:if="{{ !loading && verdict }}">
        <!-- 区域1: 标题区 -->
        <view
            class="verdict-header"
            animation="{{ headerAnimation }}"
        >
            <text class="verdict-header__icon-emoji">
                ⚖️
            </text>
            <text class="verdict-header__title">
                清汤大老爷判决书
            </text>
            <text class="verdict-header__case-no">
                案件编号: NO.{{ verdict.caseNumber }}
            </text>
        </view>

        <!-- 区域2: 责任分布 -->
         <view class="verdict-section-wrapper">
        <view
            class="verdict-section"
            animation="{{ section2Animation }}"
        >
            <text class="verdict-section__title">
                责任分布
            </text>
            <view class="responsibility">
                <!-- Host card -->
                <view class="responsibility__card responsibility__card--host">
                    <text class="responsibility__label">
                        玩家1责任
                    </text>
                    <text class="responsibility__percent">
                        {{ hostPercentDisplay }}%
                    </text>
                </view>
                <!-- Guest card -->
                <view class="responsibility__card responsibility__card--guest">
                    <text class="responsibility__label">
                        玩家2责任
                    </text>
                    <text class="responsibility__percent">
                        {{ guestPercentDisplay }}%
                    </text>
                </view>
                <!-- Third party card -->
                <view class="responsibility__card responsibility__card--third">
                    <text class="responsibility__label">
                        第三方因素
                    </text>
                    <view
                        wx:for="{{ verdict.responsibility.thirdParty }}"
                        wx:key="reason"
                        class="responsibility__factor"
                    >
                        <text class="responsibility__factor-emoji">
                            {{ item.emoji }}
                        </text>
                        <text class="responsibility__factor-name">
                            {{ item.reason }}
                        </text>
                        <text class="responsibility__factor-pct">
                            {{ item.percentage }}%
                        </text>
                    </view>
                </view>
            </view>
        </view>

        <!-- 区域3: 六维战力图 -->
        <view
            class="verdict-section"
            animation="{{ section3Animation }}"
        >
            <text class="verdict-section__title">
                双方六维战力图
            </text>
            <radar-chart
                id="radarChart"
                hostScores="{{ verdict.battleStats.host }}"
                guestScores="{{ verdict.battleStats.guest }}"
                size="{{ 500 }}"
            ></radar-chart>
        </view>

        <!-- 区域4: 大老爷赠言 -->
        <view
            class="verdict-section"
            animation="{{ section4Animation }}"
        >
            <text class="verdict-section__title">
                大老爷赠言
            </text>
            <view class="verdict-quote">
                <view class="verdict-quote__border"></view>
                <text class="verdict-quote__text">
                    "{{ summaryDisplayText }}"
                </text>
            </view>
        </view>

        <!-- 区域5: 惩罚令牌 -->
        <view
            class="verdict-section"
            animation="{{ section5Animation }}"
        >
            <text class="verdict-section__title">
                惩罚令牌
            </text>
            <view class="punishment-card">
                <text class="punishment-card__task">
                    {{ verdict.punishmentTask.task }}
                </text>
                <text class="punishment-card__deadline">
                    {{ verdict.punishmentTask.deadline }}
                </text>
            </view>
        </view>

        <!-- 区域6+7: 密折 & 保存按钮 -->
        <view
            class="verdict-section verdict-section--center verdict-actions"
            animation="{{ section6Animation }}"
        >
            <styled-button
                class="verdict-actions__btn"
                icon="🔮"
                text="查看我的密折"
                color="red"
                bind:tap="onSecretModalOpen"
            ></styled-button>
            <styled-button
                class="verdict-actions__btn"
                icon="📸"
                text="{{ saving ? '保存中...' : '保存判决书' }}"
                color="yellow"
                disabled="{{ saving }}"
                bind:tap="onSaveVerdict"
            ></styled-button>
        </view>

        <!-- 区域8: 赛后互动 -->
        <view
            class="verdict__post-game"
            animation="{{ section8Animation }}"
        >
            <!-- 赢家：执行惩戒 -->
            <view
                wx:if="{{ isWinner }}"
                class="verdict__post-btn verdict__post-btn--punish {{ actionCooldown || actionRemainingCount <= 0 ? 'verdict__post-btn--disabled' : '' }}"
                bindtap="onPostGameAction"
                data-action="execute_punishment"
            >
                <text class="verdict__post-btn-icon">⚔️</text>
                <text class="verdict__post-btn-label">执行惩戒</text>
                <text class="verdict__post-btn-sub">
                    剩余 {{ actionRemainingCount }}/5 次
                </text>
            </view>

            <!-- 输家：跪地求饶 -->
            <view
                wx:elif="{{ !isWinner && !isDraw }}"
                class="verdict__post-btn verdict__post-btn--beg {{ actionCooldown || actionRemainingCount <= 0 ? 'verdict__post-btn--disabled' : '' }}"
                bindtap="onPostGameAction"
                data-action="beg_for_mercy"
            >
                <text class="verdict__post-btn-icon">🧎</text>
                <text class="verdict__post-btn-label">跪地求饶</text>
                <text class="verdict__post-btn-sub">
                    剩余 {{ actionRemainingCount }}/5 次
                </text>
            </view>

            <!-- 退堂 (所有情况都显示) -->
            <styled-button
                class="verdict__leave-btn"
                icon="🤝"
                text="退堂"
                color="blue"
                bind:tap="onLeaveRoom"
            ></styled-button>
        </view>
        </view>
    </block>


</scroll-view>

<!-- Secret modal (must be outside scroll-view for position: fixed to work) -->
<secret-modal
    visible="{{ showSecretModal }}"
    title="{{ mySecretReport.title }}"
    advice="{{ mySecretReport.advice }}"
    topDimension="{{ myTopDimension }}"
    topScore="{{ myTopScore }}"
    bind:close="onSecretModalClose"
></secret-modal>

<!-- Post-game effect overlay (must be outside scroll-view for position: fixed to work) -->
<post-game-effect
    visible="{{ showEffectOverlay }}"
    type="{{ currentEffectType }}"
></post-game-effect>

<!-- Hidden canvas for image generation (must be outside scroll-view for position: fixed to work) -->
<canvas
    type="2d"
    id="verdictCanvas"
    class="verdict-page__offscreen-canvas"
></canvas>
