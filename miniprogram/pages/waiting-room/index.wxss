/* pages/waiting-room/index.wxss */

/* ========================================
   根容器 - 渐变背景
   ======================================== */
.waiting-room {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 750rpx;
    min-height: 100vh;
    box-sizing: border-box;
    background: linear-gradient(135deg, #ff3b30 0%, #ff7a00 50%, #ffc400 100%);
    padding-top: 120rpx;
    padding-bottom: env(safe-area-inset-bottom);
}

/* ========================================
   标题区域
   ======================================== */
.waiting-room__header {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-bottom: 80rpx;
    flex: 1;
}

.waiting-room__title {
    font-size: 72rpx;
    font-weight: 900;
    color: #ffffff;
    /* 漫画风黑描边效果 - 多重text-shadow实现 */
    text-shadow:
        /* 描边效果 */
        -4rpx -4rpx 0 #000000,
        4rpx -4rpx 0 #000000,
        -4rpx 4rpx 0 #000000,
        4rpx 4rpx 0 #000000,
        -6rpx 0 0 #000000,
        6rpx 0 0 #000000,
        0 -6rpx 0 #000000,
        0 6rpx 0 #000000,
        /* 立体投影效果 */ 8rpx 8rpx 0 rgba(0, 0, 0, 0.5);
    letter-spacing: 8rpx;
}

/* ========================================
   按钮区域 - Entry 模式
   ======================================== */
.waiting-room__buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 60rpx;
    margin-top: 60rpx;
    flex: 1;
}

/* 按钮包装器 - 用于动画绑定 */
.waiting-room__button-wrapper {
    width: 800rpx;
    display: flex;
    justify-content: center;
}

/* ========================================
   Styled Button 在 Waiting Room 中的样式覆盖
   使用更具体的选择器来覆盖组件默认样式
   ======================================== */
.waiting-room__styled-btn {
    width: 600rpx;
}

/* 取消按钮包装器 */
.waiting-room__cancel-wrapper {
    margin-top: 120rpx;
}

/* ========================================
   等待区域 - host_waiting / guest_waiting
   ======================================== */
.waiting-room__waiting {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 0 50rpx;
    box-sizing: border-box;
    flex:1
}

/* 房间信息 */
.waiting-room__room-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 60rpx;
}

.waiting-room__room-label {
    font-size: 36rpx;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 24rpx;
    font-weight: 500;
}

/* 房间号展示 */
.waiting-room__room-code {
    display: flex;
    flex-direction: row;
    gap: 16rpx;
}

.waiting-room__room-code--small {
    gap: 12rpx;
    margin: 30rpx 0;
}

.waiting-room__room-digit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 88rpx;
    height: 100rpx;
    background-color: #ffffff;
    border-radius: 16rpx;
    border: 6rpx solid #000000;
    font-size: 56rpx;
    font-weight: 800;
    color: #333333;
    box-shadow: 0 6rpx 0 0 #000000;
}

.waiting-room__room-digit--small {
    width: 72rpx;
    height: 84rpx;
    font-size: 44rpx;
    border: 4rpx solid #000000;
    box-shadow: 0 4rpx 0 0 #000000;
}

/* 等待文案 */
.waiting-room__waiting-text {
    font-size: 48rpx;
    color: rgba(255, 255, 255, 0.95);
    text-align: center;
    min-height: 48rpx;
    font-weight: 500;
}

/* 访客模式信息 */
.waiting-room__guest-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 40rpx;
}

.waiting-room__guest-success {
    font-size: 40rpx;
    color: #ffffff;
    font-weight: 700;
    text-shadow:
        -2rpx -2rpx 0 #000000,
        2rpx -2rpx 0 #000000,
        -2rpx 2rpx 0 #000000,
        2rpx 2rpx 0 #000000;
}

.waiting-room__guest-waiting {
    font-size: 32rpx;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 20rpx;
}

/* ========================================
   加入房间弹窗
   ======================================== */
.waiting-room__modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.waiting-room__modal {
    position: relative;
    width: 650rpx;
    background-color: #ffffff;
    border-radius: 32rpx;
    border: 8rpx solid #000000;
    padding: 60rpx 40rpx;
    box-sizing: border-box;
    box-shadow: 0 10rpx 0 0 #000000;
}

/* 关闭按钮 */
.waiting-room__modal-close {
    position: absolute;
    top: 20rpx;
    right: 30rpx;
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.waiting-room__modal-close text {
    font-size: 56rpx;
    color: #666666;
    font-weight: 300;
    line-height: 1;
}

/* 弹窗标题 */
.waiting-room__modal-title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #333333;
    text-align: center;
    margin-bottom: 50rpx;
}

/* 输入框区域 */
.waiting-room__code-input-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: 30rpx;
}

.waiting-room__code-boxes {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 16rpx;
}

.waiting-room__code-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80rpx;
    height: 100rpx;
    background-color: #f5f5f5;
    border-radius: 16rpx;
    border: 4rpx solid #cccccc;
    font-size: 48rpx;
    font-weight: 700;
    color: #333333;
}

.waiting-room__code-box--filled {
    border-color: #6e95f7;
    background-color: #ffffff;
}

/* 隐藏的真实输入框 - 原生组件需要特殊处理 */
.waiting-room__code-input {
    position: absolute;
    top: 0;
    left: -9999rpx;
    width: 100%;
    height: 100%;
    opacity: 0;
}

/* 错误提示 */
.waiting-room__error {
    text-align: center;
    margin-bottom: 30rpx;
}

.waiting-room__error text {
    font-size: 28rpx;
    color: #e53935;
}

/* ========================================
   倒计时遮罩
   ======================================== */
.waiting-room__countdown-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
}

.waiting-room__countdown {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.waiting-room__countdown-number {
    font-size: 200rpx;
    font-weight: 900;
    color: #ffd200;
    text-shadow:
        -8rpx -8rpx 0 #000000,
        8rpx -8rpx 0 #000000,
        -8rpx 8rpx 0 #000000,
        8rpx 8rpx 0 #000000,
        0 -10rpx 0 #000000,
        0 10rpx 0 #000000,
        -10rpx 0 0 #000000,
        10rpx 0 0 #000000,
        12rpx 12rpx 0 rgba(0, 0, 0, 0.6);
    line-height: 1;
}

.waiting-room__countdown-text {
    font-size: 48rpx;
    color: #ffffff;
    font-weight: 700;
    margin-top: 40rpx;
    text-shadow:
        -2rpx -2rpx 0 #000000,
        2rpx -2rpx 0 #000000,
        -2rpx 2rpx 0 #000000,
        2rpx 2rpx 0 #000000;
}
