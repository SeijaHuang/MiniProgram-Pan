<!--pages/welcome/index.wxml-->
<view class="welcome-page">
    <!-- Section B: Main Visual Character -->
    <view class="welcome-page__hero">
        <!-- Emotional Title -->
        <view class="welcome-page__title">
            <text class="welcome-page__title-text">判了么</text>
        </view>

        <view class="welcome-page__avatar-wrapper" animation="{{ avatarAnimation }}">
            <!-- Top decoration (crown/badge placeholder) -->
            <view class="welcome-page__avatar-badge">
                <text class="welcome-page__badge-icon">👑</text>
            </view>
            <!-- Circular avatar container -->
            <view class="welcome-page__avatar-container">
                <image
                    class="welcome-page__avatar-image"
                    src="https://images.unsplash.com/photo-1611991687319-5dabaabde43a?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHx5ZWxsb3clMjBkdWNrJTIwY2FydG9vbnxlbnwxfHx8fDE3NjgyMDQ3MTV8MA&ixlib=rb-4.1.0&q=80&w=1080"
                    mode="aspectFill"
                ></image>
            </view>
        </view>

        <!-- Subtitle + Slogan Block -->
        <view class="welcome-page__tagline">
            <view class="welcome-page__tagline-primary">
                <text class="welcome-page__tagline-primary-text">清汤大老爷在线断案</text>
            </view>
            <view class="welcome-page__tagline-secondary">
                <text class="welcome-page__tagline-secondary-text">将争吵转化为游戏 · 在爆笑中和好如初</text>
            </view>
        </view>
    </view>

    <!-- Section C: Main CTA Button -->
    <view class="welcome-page__actions">
        <button
            class="welcome-page__btn welcome-page__btn--cta"
            hover-class="welcome-page__btn--cta-pressed"
            bindtap="handleStartJudge"
        >
            <!-- Light sweep effect layer -->
            <view class="welcome-page__btn-shine"></view>
            <text class="welcome-page__btn-text">我要申冤</text>
        </button>
    </view>

    <!-- Section D: Bottom Function Area -->
    <view class="welcome-page__footer">
        <view class="welcome-page__footer-item" bindtap="handleSettings">
            <text class="welcome-page__footer-text">设置</text>
        </view>
        <view class="welcome-page__footer-item" bindtap="handleRules">
            <text class="welcome-page__footer-text">规则</text>
        </view>
        <view class="welcome-page__footer-item" bindtap="handleFeedback">

            <text class="welcome-page__footer-text">反馈</text>
        </view>
    </view>
</view>
