<!--pages/welcome/index.wxml-->
<view class="welcome-page">
    <!-- Section B: Main Visual Character -->
    <view class="welcome-page__hero">
        <!-- 阶段 1：主标题 - 旋转 + 缩放入场 -->
        <styled-title
            text="判了么"
            isInitial="{{ isEntranceReady }}"
            animation="{{ titleAnimation }}"
        ></styled-title>

        <!-- 阶段 2：头像 - 缩放入场 + 呼吸动画 -->
        <avatar
            src="../../assets/logo.jpg"
            playEntrance="{{ isEntranceReady }}"
            entranceDelay="{{ 400 }}"
        ></avatar>

        <!-- 阶段 3：副标题 + Slogan - 上滑入场 -->
        <view
            class="welcome-page__tagline {{ isEntranceReady ? 'welcome-page__tagline--initial' : '' }}"
            animation="{{ taglineAnimation }}"
        >
            <view class="welcome-page__tagline-primary">
                <text class="welcome-page__tagline-primary-text">清汤大老爷在线断案</text>
            </view>
            <view class="welcome-page__tagline-secondary">
                <text class="welcome-page__tagline-secondary-text">将争吵转化为游戏 · 在爆笑中和好如初</text>
            </view>
        </view>
    </view>

    <!-- 阶段 4：CTA 按钮 - 弹性缩放入场 -->
    <view
        class="welcome-page__actions {{ isEntranceReady ? 'welcome-page__actions--initial' : '' }}"
        animation="{{ ctaAnimation }}"
    >
        <styled-button
            text="我要申冤"
            bindtap="handleStartJudge"
        ></styled-button>
    </view>

    <!-- 备案信息 -->
    <view class="welcome-page__icp">
        <text class="welcome-page__icp-text">沪ICP备2026007177号</text>
    </view>

</view>
