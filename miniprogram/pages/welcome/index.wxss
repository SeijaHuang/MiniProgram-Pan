/* pages/welcome/index.wxss */

/* ========================================
   PAGE CONTAINER
   极简全屏渐变背景，无装饰元素
   ======================================== */
.welcome-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 750rpx;
    min-height: 100vh;
    box-sizing: border-box;
    background: linear-gradient(135deg, #ff3b30 0%, #ff7a00 50%, #ffc400 100%);
}

/* Section B: Hero Character Area */
.welcome-page__hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 40rpx 0;
}

/* ========================================
   阶段 2：头像
   入场效果：缩放 + 淡入
   idle 效果：轻微上下浮动
   ======================================== */
.welcome-page__avatar-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* 头像初始状态：缩小 + 透明 */
.welcome-page__avatar-wrapper--initial {
    opacity: 0;
    transform: scale(0.6);
}

/* Top decoration badge */
.welcome-page__avatar-badge {
    position: absolute;
    top: -45rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 60rpx;
    height: 60rpx;
    z-index: 10;
}

.welcome-page__badge-icon {
    width: 100%;
    height: 100%;
    font-size: 60rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

/* Circular avatar container */
.welcome-page__avatar-container {
    width: 220rpx;
    height: 220rpx;
    border-radius: 50%;
    background-color: #ffffff;
    border: 8rpx solid #1a1a1a;
    box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.25);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.welcome-page__avatar-image {
    width: 100%;
    height: 100%;
}

/* ========================================
   阶段 3：副标题 + Slogan
   入场效果：上滑 + 淡入
   ======================================== */
.welcome-page__tagline {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 48rpx;
    padding: 0 40rpx;
    gap: 12rpx;
}

/* 副标题初始状态：下移 + 透明 */
.welcome-page__tagline--initial {
    opacity: 0;
    transform: translateY(40rpx);
}

/* Primary tagline - 副标题（亮黄色 + 黑色描边） */
.welcome-page__tagline-primary {
    display: flex;
    justify-content: center;
    align-items: center;
}

.welcome-page__tagline-primary-text {
    font-size: 44rpx;
    font-weight: 700;
    color: #ffd000;
    letter-spacing: 4rpx;
    /* 仅保留轻微立体阴影，不做描边 */
    text-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 1);
}

/* Secondary tagline - Slogan（白色 + 黑色描边） */
.welcome-page__tagline-secondary {
    display: flex;
    justify-content: center;
    align-items: center;
}

.welcome-page__tagline-secondary-text {
    font-size: 28rpx;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: 2rpx;
    /* 仅保留柔和投影，不做描边 */
    text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 1);
}

/* ========================================
   阶段 4：CTA 按钮
   入场效果：弹性缩放 + 落地感
   idle 效果：光扫动画
   ======================================== */
.welcome-page__actions {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40rpx 60rpx;
    box-sizing: border-box;
}

/* CTA 按钮初始状态：缩小 + 透明 */
.welcome-page__actions--initial {
    opacity: 0;
    transform: scale(0);
}

/* ========================================
   阶段 5：底部功能区
   入场效果：淡入
   ======================================== */
.welcome-page__footer {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding: 40rpx 60rpx 80rpx;
    box-sizing: border-box;
}

/* 底部导航初始状态：透明 */
.welcome-page__footer--initial {
    opacity: 0;
}

.welcome-page__footer-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12rpx;
}

.welcome-page__footer-icon {
    width: 48rpx;
    height: 48rpx;
}

.welcome-page__footer-text {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}
