/* pages/welcome/index.wxss */

/* ========================================
   PAGE CONTAINER
   极简全屏渐变背景，无装饰元素
   ======================================== */
.welcome-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 750rpx;
    min-height: 100vh;
    box-sizing: border-box;
    background: linear-gradient(135deg, #ff3b30 0%, #ff7a00 50%, #ffc400 100%);
}

/* Section A: Header Decoration */
.welcome-page__header {
    width: 100%;
    height: 120rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.welcome-page__header-decoration {
    width: 100rpx;
    height: 8rpx;
    background-color: rgba(255, 255, 255, 0.4);
    border-radius: 4rpx;
}

/* Section B: Hero Character Area */
.welcome-page__hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 40rpx 0;
}

/* Emotional Title */
.welcome-page__title {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 48rpx;
}

.welcome-page__title-text {
    font-size: 96rpx;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 8rpx;
    text-shadow:
        /* 黑色描边（四周） */
        -3rpx 0 0 #000000,
        3rpx 0 0 #000000,
        0 -3rpx 0 #000000,
        0 3rpx 0 #000000,
        -3rpx -3rpx 0 #000000,
        3rpx -3rpx 0 #000000,
        -3rpx 3rpx 0 #000000,
        3rpx 3rpx 0 #000000,
        /* 右下角黑色投影 */ 8rpx 10rpx 0 #000000;
}

/* Avatar wrapper - contains badge and circle */
.welcome-page__avatar-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* Top decoration badge */
.welcome-page__avatar-badge {
    position: absolute;
    top: -30rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 60rpx;
    height: 60rpx;
    z-index: 10;
}

.welcome-page__badge-icon {
    width: 100%;
    height: 100%;
}

/* Circular avatar container */
.welcome-page__avatar-container {
    width: 220rpx;
    height: 220rpx;
    border-radius: 50%;
    background-color: #ffffff;
    border: 8rpx solid #1a1a1a;
    box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.25);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.welcome-page__avatar-image {
    width: 180rpx;
    height: 180rpx;
}

/* Subtitle + Slogan Block */
.welcome-page__tagline {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 48rpx;
    padding: 0 40rpx;
    gap: 12rpx;
}

/* Primary tagline - 副标题（亮黄色 + 黑色描边） */
.welcome-page__tagline-primary {
    display: flex;
    justify-content: center;
    align-items: center;
}

.welcome-page__tagline-primary-text {
    font-size: 44rpx;
    font-weight: 700;
    color: #ffd000;
    letter-spacing: 4rpx;
    /* 仅保留轻微立体阴影，不做描边 */
    text-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 1);
}

/* Secondary tagline - Slogan（白色 + 黑色描边） */
.welcome-page__tagline-secondary {
    display: flex;
    justify-content: center;
    align-items: center;
}

.welcome-page__tagline-secondary-text {
    font-size: 28rpx;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: 2rpx;
    /* 仅保留柔和投影，不做描边 */
    text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 1);
}

/* Section C: Main CTA Button */
.welcome-page__actions {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40rpx 60rpx;
    box-sizing: border-box;
}

.welcome-page__btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 24rpx;
    border: none;
    transition:
        transform 0.1s ease-out,
        box-shadow 0.1s ease-out;
}

/* 主 CTA 按钮 - 红色背景 + 粗黑描边 + 底部厚度感 */
.welcome-page__btn--cta {
    background: linear-gradient(180deg, #ff3b30 0%, #e6392e 100%);
    border: 8rpx solid #000000;
    border-bottom-width: 12rpx;
    box-shadow:
        0 8rpx 0 0 #000000,
        0 12rpx 16rpx rgba(0, 0, 0, 0.3);
    position: relative;
}

.welcome-page__btn--cta .welcome-page__btn-text {
    font-size: 40rpx;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 2rpx;
}

/* 按压状态 - hover-class */
.welcome-page__btn--cta-pressed {
    transform: scale(0.96) translateY(6rpx);
    box-shadow:
        0 2rpx 0 0 #000000,
        0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* Section D: Footer Function Area */
.welcome-page__footer {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding: 40rpx 60rpx 80rpx;
    box-sizing: border-box;
}

.welcome-page__footer-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12rpx;
}

.welcome-page__footer-icon {
    width: 48rpx;
    height: 48rpx;
}

.welcome-page__footer-text {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}
