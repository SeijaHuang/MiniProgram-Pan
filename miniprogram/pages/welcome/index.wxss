/* pages/welcome/index.wxss */

/* Page Container */
.welcome-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    width: 750rpx;
    background-color: #f5f5f5;
    box-sizing: border-box;
}

/* Section A: Header Decoration */
.welcome-page__header {
    width: 100%;
    height: 120rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.welcome-page__decoration {
    width: 100rpx;
    height: 8rpx;
    background-color: #e0e0e0;
    border-radius: 4rpx;
}

/* Section B: Hero Character Area */
.welcome-page__hero {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 40rpx 0;
}

.welcome-page__character {
    width: 400rpx;
    height: 400rpx;
}

/* Section C: Action Buttons */
.welcome-page__actions {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40rpx 60rpx;
    gap: 24rpx;
    box-sizing: border-box;
}

.welcome-page__btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 48rpx;
    border: none;
}

.welcome-page__btn--primary {
    background-color: #ffcc00;
}

.welcome-page__btn--secondary {
    background-color: #ffffff;
    border: 2rpx solid #e0e0e0;
}

.welcome-page__btn-text {
    font-size: 32rpx;
    font-weight: 500;
}

.welcome-page__btn--primary .welcome-page__btn-text {
    color: #333333;
}

.welcome-page__btn--secondary .welcome-page__btn-text {
    color: #666666;
}

/* Section D: Footer Function Area */
.welcome-page__footer {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding: 40rpx 60rpx 80rpx;
    box-sizing: border-box;
}

.welcome-page__footer-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12rpx;
}

.welcome-page__footer-icon {
    width: 48rpx;
    height: 48rpx;
}

.welcome-page__footer-text {
    font-size: 24rpx;
    color: #999999;
}
