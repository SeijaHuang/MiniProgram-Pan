/* pages/welcome/index.wxss */

/* ========================================
   PAGE CONTAINER
   极简全屏渐变背景，无装饰元素
   ======================================== */
.welcome-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 750rpx;
    min-height: 100vh;
    box-sizing: border-box;
    background: linear-gradient(
        135deg,
        #ff3b30 0%,
        #ff7a00 50%,
        #ffc400 100%
    );
}

/* Section A: Header Decoration */
.welcome-page__header {
    width: 100%;
    height: 120rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.welcome-page__header-decoration {
    width: 100rpx;
    height: 8rpx;
    background-color: rgba(255, 255, 255, 0.4);
    border-radius: 4rpx;
}

/* Section B: Hero Character Area */
.welcome-page__hero {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 40rpx 0;
}

/* Avatar wrapper - contains badge and circle */
.welcome-page__avatar-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* Top decoration badge */
.welcome-page__avatar-badge {
    position: absolute;
    top: -30rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 60rpx;
    height: 60rpx;
    z-index: 10;
}

.welcome-page__badge-icon {
    width: 100%;
    height: 100%;
}

/* Circular avatar container */
.welcome-page__avatar-container {
    width: 220rpx;
    height: 220rpx;
    border-radius: 50%;
    background-color: #ffffff;
    border: 8rpx solid #1a1a1a;
    box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.25);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.welcome-page__avatar-image {
    width: 180rpx;
    height: 180rpx;
}

/* Section C: Action Buttons */
.welcome-page__actions {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40rpx 60rpx;
    gap: 24rpx;
    box-sizing: border-box;
}

.welcome-page__btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 48rpx;
    border: none;
}

.welcome-page__btn--primary {
    background-color: #ffcc00;
}

.welcome-page__btn--secondary {
    background-color: #ffffff;
    border: 2rpx solid #e0e0e0;
}

.welcome-page__btn-text {
    font-size: 32rpx;
    font-weight: 500;
}

.welcome-page__btn--primary .welcome-page__btn-text {
    color: #333333;
}

.welcome-page__btn--secondary .welcome-page__btn-text {
    color: #666666;
}

/* Section D: Footer Function Area */
.welcome-page__footer {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding: 40rpx 60rpx 80rpx;
    box-sizing: border-box;
}

.welcome-page__footer-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12rpx;
}

.welcome-page__footer-icon {
    width: 48rpx;
    height: 48rpx;
}

.welcome-page__footer-text {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}
