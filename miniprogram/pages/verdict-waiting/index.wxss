/* packageB/pages/verdict-waiting/index.wxss */
/* No CSS animation/transition/keyframes — all driven by wx.createAnimation */

/* ===== Page container ===== */
.page {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    position: relative;
    background: linear-gradient(
        180deg,
        #7b2fbe 0%,
        #9b30ff 30%,
        #c850c0 60%,
        #e8447a 100%
    );
}

/* ===== Particle layer ===== */
.page__particles {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    pointer-events: none;
}

.page__particle {
    position: absolute;
    bottom: 20rpx;
    border-radius: 50%;
    background: #ffffff;
}

/* ===== Main content ===== */
.page__content {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 180rpx;
    padding-bottom: 0;
    box-sizing: border-box;
}

/* ===== Back button ===== */
.nav-back {
    position: absolute;
    top: 80rpx;
    left: 30rpx;
    width: 64rpx;
    height: 64rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    z-index: 10;
}

.nav-back__icon {
    font-size: 36rpx;
    color: #ffffff;
}

/* ===== Title ===== */
.title {
    margin-bottom: 30rpx;
}

.title__text {
    font-size: 48rpx;
    font-weight: 900;
    color: #ffd93d;
    letter-spacing: 4rpx;
}

/* ===== Judge duck ===== */
.duck {
    margin-bottom: 20rpx;
}

.duck__float,
.duck__wobble {
    display: flex;
    align-items: center;
    justify-content: center;
}

.duck__image {
    width: 200rpx;
    height: 240rpx;
}

.duck__emoji {
    font-size: 120rpx;
}

/* ===== Dog collision area ===== */
.dogs {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 160rpx;
    margin-bottom: 50rpx;
    position: relative;
}

.dogs__left,
.dogs__right {
    display: flex;
    align-items: center;
    justify-content: center;
}

.dogs__emoji {
    font-size: 80rpx;
}

.dogs__right {
    transform: scaleX(-1);
}

.dogs__collision {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -30rpx;
    margin-top: -30rpx;
    z-index: 5;
}

.dogs__collision-emoji {
    font-size: 60rpx;
}

/* ===== Text card ===== */
.card {
    width: 580rpx;
    flex: 1;
    background: rgba(255, 240, 255, 0.92);
    border-radius: 24rpx;
    border: 3px solid #2d2d2d;
    box-shadow: 4rpx 4rpx 0 #2d2d2d;
    padding: 30rpx 36rpx;
    margin-bottom: 60rpx;
    overflow: hidden;
    opacity: 0;
    transform: translateY(30px);
    display: flex;
    flex-direction: column;
}

.card__line {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
    flex-shrink: 0;
    opacity: 0;
}

.card__line:last-child {
    margin-bottom: 0;
}

.card__gear {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12rpx;
    flex-shrink: 0;
}

.card__gear-emoji {
    font-size: 28rpx;
}

.card__text {
    font-size: 28rpx;
    color: #6b3fa0;
    font-weight: 500;
    line-height: 44rpx;
}

.card__line--final {
    justify-content: center;
}

.card__text--final {
    color: #c8102e;
    font-weight: 700;
    font-size: 32rpx;
}

/* ===== Timeout overlay ===== */
.timeout {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
}

.timeout__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60rpx 40rpx;
}

.timeout__duck {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 40rpx;
}

.timeout__duck-emoji {
    font-size: 120rpx;
    margin-bottom: 40rpx;
}

.timeout__title {
    font-size: 48rpx;
    font-weight: 900;
    color: #ffd93d;
    margin-bottom: 16rpx;
}

.timeout__subtitle {
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 60rpx;
    text-align: center;
}

.timeout__btn {
    width: 400rpx;
    height: 88rpx;
    border-radius: 44rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24rpx;
}

.timeout__btn--primary {
    background: #ffd93d;
}

.timeout__btn--secondary {
    background: transparent;
    border: 2px solid #ffffff;
}

.timeout__btn-text {
    font-size: 30rpx;
    font-weight: 600;
    color: #2d3436;
}

.timeout__btn-text--light {
    color: #ffffff;
}
