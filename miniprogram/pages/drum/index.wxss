/* pages/drum/index.wxss */

.drum-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 750rpx;
    min-height: 100vh;
    box-sizing: border-box;
    background: linear-gradient(180deg, #B43ACB 0%, #FF3D8E 100%);
}

.drum-page__title {
    font-size: 48rpx;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 20rpx;
}

.drum-page__subtitle {
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.8);
}
