{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",

        "rootDir": "./src",
        "outDir": "./dist",

        "types": ["node"],

        "strict": true,
        "esModuleInterop": true,

        "sourceMap": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "scripts"]
}
