# ===========================================
# Backend Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# -------------------------------------------
# Server (Required)
# -------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# -------------------------------------------
# WebSocket
# -------------------------------------------
WS_PATH=/ws

# -------------------------------------------
# PostgreSQL Database (Required)
# -------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local development (without Docker):
DATABASE_URL=postgresql://chatroom:chatroom_dev_pwd@localhost:5432/chatroom?schema=public
# Docker Compose (backend inside container):
# DATABASE_URL=postgresql://chatroom:chatroom_dev_pwd@postgres:5432/chatroom?schema=public

# -------------------------------------------
# OpenAI (Required for LLM Worker)
# -------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
# Optional: Base URL for OpenAI-compatible APIs (e.g. Azure, local proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# -------------------------------------------
# LLM Worker Tuning (Optional, all have defaults)
# -------------------------------------------
# How often the worker polls for new tasks (ms)
# LLM_WORKER_POLL_INTERVAL_MS=500
# Lock timeout for room-level task execution (ms)
# LLM_WORKER_LOCK_TIMEOUT_MS=60000
# Max retries for failed LLM calls
# LLM_MAX_RETRIES=3
