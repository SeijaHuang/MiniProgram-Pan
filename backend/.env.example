# ===========================================
# Backend Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# Server Configuration
PORT=8080
NODE_ENV=development

# WebSocket Configuration
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL=30000
WS_CLIENT_TIMEOUT=60000
WS_MAX_RECONNECT=5

# Game Configuration
GAME_ROOM_TIMEOUT=300000
GAME_MOVE_TIMEOUT=30000

# Logging
LOG_LEVEL=debug

# ===========================================
# PostgreSQL Database (Required)
# ===========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local development (without Docker):
DATABASE_URL=postgresql://chatroom:chatroom_dev_pwd@localhost:5432/chatroom?schema=public
# Docker Compose (backend inside container):
# DATABASE_URL=postgresql://chatroom:chatroom_dev_pwd@postgres:5432/chatroom?schema=public

# ===========================================
# OpenAI Configuration (Required for LLM)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
# Optional: Base URL for OpenAI-compatible APIs
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===========================================
# LLM Worker Configuration
# ===========================================
# How often the worker polls for new tasks (ms)
LLM_WORKER_POLL_INTERVAL_MS=500
# Lock timeout for room-level task execution (ms)
LLM_WORKER_LOCK_TIMEOUT_MS=60000
# Max retries for failed LLM calls
LLM_MAX_RETRIES=3
