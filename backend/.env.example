# ===========================================
# Backend Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# -------------------------------------------
# Server (Required)
# -------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# -------------------------------------------
# WebSocket
# -------------------------------------------
WS_PATH=/ws

# -------------------------------------------
# OpenAI (Required for LLM Judgement API)
# -------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
# Optional: Base URL for OpenAI-compatible APIs (e.g. Azure, local proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1
